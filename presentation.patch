+package forge.game.mana;
+
+import forge.ai.AITest;
+import forge.ai.AvailableActions;
+import forge.ai.ComputerUtilMana;
+import forge.card.mana.ManaCost;
+import forge.card.mana.ManaCostParser;
+import forge.game.Game;
+import forge.game.card.Card;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import org.testng.Assert;
+import org.testng.annotations.Test;
+
+/** Actual Forge cards and payment code, including the action-highlight sweep. */
+public class VintageManaRegressionTest extends AITest {
+    private SpellAbility spell(String name, Player p) {
+        SpellAbility sa = addCardToZone(name, p, ZoneType.Hand).getFirstSpellAbility();
+        sa.setActivatingPlayer(p);
+        return sa;
+    }
+    private SpellAbility workshop(Player p) {
+        Card card = addCard("Mishra's Workshop", p);
+        SpellAbility mana = card.getManaAbilities().get(0);
+        mana.setActivatingPlayer(p);
+        mana.getManaPart().produceMana("C C C", p, mana);
+        card.setTapped(true);
+        Assert.assertEquals(p.getManaPool().totalMana(), 3);
+        return mana;
+    }
+    private ManaCostBeingPaid cost(String text) {
+        return new ManaCostBeingPaid(new ManaCost(new ManaCostParser(text)));
+    }
+    @Test public void threeManaPaysOneThenAnotherWithoutLosingTheRest() {
+        Game game = initAndCreateGame();
+        Player p = game.getPlayers().get(1);
+        workshop(p);
+        ComputerUtilMana.payManaCost(cost("1"), spell("Vexing Bauble", p), p, false);
+        Assert.assertEquals(p.getManaPool().totalMana(), 2);
+        ComputerUtilMana.payManaCost(cost("1"), spell("Sol Ring", p), p, false);
+        Assert.assertEquals(p.getManaPool().totalMana(), 1);
+        p.getManaPool().clearPool(true);
+        Assert.assertEquals(p.getManaPool().totalMana(), 0);
+    }
+    @Test public void directManaActivationLeavesTwoAndTaxConsumesTheRemainder() {
+        Game game = initAndCreateGame();
+        Player p = game.getPlayers().get(1);
+        SpellAbility mana = workshop(p);
+        SpellAbility bauble = spell("Vexing Bauble", p);
+        ManaCostBeingPaid payment = cost("1");
+        p.getManaPool().payManaFromAbility(bauble, payment, mana);
+        Assert.assertTrue(payment.isPaid());
+        Assert.assertEquals(p.getManaPool().totalMana(), 2);
+        addCard("Sphere of Resistance", p);
+        SpellAbility ring = spell("Sol Ring", p);
+        Assert.assertTrue(ComputerUtilMana.payManaCost(forge.game.cost.CostAdjustment.adjust(ring.getPayCosts(), ring, false), p, ring, false));
+        Assert.assertEquals(p.getManaPool().totalMana(), 0);
+    }
+    @Test public void actionPreviewsLeaveFloatingManaUntouched() {
+        Game game = initAndCreateGame();
+        Player p = game.getPlayers().get(1);
+        workshop(p);
+        spell("Vexing Bauble", p);
+        SpellAbility expensive = spell("Steel Overseer", p);
+        addCard("Sphere of Resistance", p);
+        addCard("Sphere of Resistance", p);
+        for (int i = 0; i < 4; i++) {
+            Assert.assertFalse(ComputerUtilMana.canPayManaCost(expensive, p, 0, false));
+            Assert.assertEquals(p.getManaPool().totalMana(), 3);
+            AvailableActions.collectActionable(p, 1500);
+            Assert.assertEquals(p.getManaPool().totalMana(), 3);
+        }
+    }
+    @Test public void russianRulesReachLiveCardView() {
+        forge.util.CardTranslation.preloadTranslation("ru-RU", forge.localinstance.properties.ForgeConstants.LANG_DIR);
+        try {
+            Game game = initAndCreateGame();
+            Player p = game.getPlayers().get(1);
+            Card card = addCard("Mishra's Workshop", p);
+            String text = forge.gui.card.CardDetailUtil.composeCardText(card.getView().getCurrentState(), game.getView(), true);
+            Assert.assertTrue(text.contains("добавьте"), text);
+            Assert.assertTrue(text.contains("артефактов"), text);
+        } finally {
+            forge.util.CardTranslation.preloadTranslation("en-US", forge.localinstance.properties.ForgeConstants.LANG_DIR);
+        }
+    }
+    @Test public void workshopCannotPayNonArtifactOrActivatedAbility() {
+        Game game = initAndCreateGame();
+        Player p = game.getPlayers().get(1);
+        workshop(p);
+        Assert.assertFalse(ComputerUtilMana.canPayManaCost(spell("Oath of Druids", p), p, 0, false));
+        Card walker = addCard("Hangarback Walker", p);
+        walker.setSickness(false);
+        SpellAbility activate = walker.getSpellAbilities().stream()
+                .filter(sa -> sa.isActivatedAbility() && !sa.isManaAbility()).findFirst().orElseThrow();
+        activate.setActivatingPlayer(p);
+        Assert.assertFalse(ComputerUtilMana.canPayManaCost(activate, p, 0, false));
+        Assert.assertEquals(p.getManaPool().totalMana(), 3);
+    }
+}
