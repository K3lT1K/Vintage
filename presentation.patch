diff --git a/forge-ai/src/main/java/forge/ai/vintage/VintageCardRules.java b/forge-ai/src/main/java/forge/ai/vintage/VintageCardRules.java
new file mode 100644
index 0000000..bb066ad
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/vintage/VintageCardRules.java
@@ -0,0 +1,116 @@
+package forge.ai.vintage;
+
+import forge.game.card.Card;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/** Specialist spell policies. Only own hand and public zones/counts are read.
+ * Null delegates to Forge. Never changes game state or pays costs. */
+public final class VintageCardRules {
+    private VintageCardRules() { }
+    public static Boolean choose(Player p, SpellAbility sa) {
+        if (!VintageStrategy.enabled(p)) return null;
+        if (!sa.isSpell()) {
+            if (VintageDoomsday.inPile(p) && (sa.isCycling() || (!sa.isManaAbility()
+                    && List.of("Flooded Strand", "Misty Rainforest", "Scalding Tarn").contains(sa.getHostCard().getName()))))
+                return result(p, "preserve-pile", false, "do not cycle or fetch-shuffle the established pile");
+            return null;
+        }
+        Boolean combo = VintageConsultation.choose(p, sa);
+        if (combo != null) return combo;
+        return switch (sa.getHostCard().getName()) {
+            case "Gaea's Blessing" -> blessing(p, sa);
+            case "Gitaxian Probe" -> probe(p, sa);
+            case "Mindbreak Trap" -> trap(p, sa);
+            default -> VintageDoomsday.choose(p, sa);
+        };
+    }
+    private static boolean result(Player p, String rule, boolean play, String reason) {
+        VintageStrategy.log(p, rule, (play ? "play: " : "hold: ") + reason);
+        return play;
+    }
+    static boolean publicCard(Player p, String name) {
+        for (Card c : p.getGame().getCardsIn(ZoneType.Battlefield))
+            if (!c.isFaceDown() && c.getName().equals(name)) return true;
+        return false;
+    }
+    private static boolean drawAllowed(Player p) {
+        // Conservative around draw replacement/punishment; no concealed cards inspected.
+        for (Card c : p.getOpponents().getCardsIn(ZoneType.Battlefield)) {
+            if (c.isFaceDown()) continue;
+            if (List.of("Narset, Parter of Veils", "Notion Thief", "Hullbreacher", "Spirit of the Labyrinth").contains(c.getName())) return false;
+            if (c.getName().equals("Orcish Bowmasters") && p.getLife() <= 2) return false;
+        }
+        return !publicCard(p, "Spirit of the Labyrinth");
+    }
+    public static boolean probe(Player p, SpellAbility sa) {
+        sa.resetTargets();
+        if (p.getCardsIn(ZoneType.Library).isEmpty() || !drawAllowed(p)) return result(p, "probe-safety", false, "empty library or public draw lock/danger");
+        if (VintageDoomsday.inPile(p)) return result(p, "probe-pile", false, "preserve the planned Recall draw sequence");
+        Player target = p.getOpponents().stream().filter(sa::canTarget).findFirst().orElse(null);
+        // Empty opposing hand is still a useful cantrip. Hexproof can be bypassed by targeting self.
+        if (target == null && sa.canTarget(p)) target = p;
+        if (target == null) return result(p, "probe-target", false, "no legal player target");
+        sa.getTargets().add(target);
+        // Script retains AIPhyrexianPayment Never: do not spend two life blindly.
+        return result(p, "probe-information", true, "draw and legally reveal before committing; blue mana payment only");
+    }
+    public static boolean blessing(Player p, SpellAbility sa) {
+        sa.resetTargets();
+        SpellAbility move = sa.getSubAbility();
+        if (move == null) return false;
+        move.resetTargets();
+        if (!sa.canTarget(p)) return result(p, "blessing-target", false, "cannot target own player");
+        sa.getTargets().add(p); // never replenish the opponent's resources accidentally
+        List<Card> candidates = new ArrayList<>();
+        for (Card c : p.getCardsIn(ZoneType.Graveyard)) if (move.canTarget(c)) candidates.add(c);
+        candidates.sort(Comparator.comparingInt(VintageCardRules::recycleValue).reversed().thenComparing((Card c) -> c.getName()));
+        for (Card c : candidates) {
+            if (move.getTargets().size() >= 3 || recycleValue(c) <= 0) break;
+            move.getTargets().add(c);
+        }
+        boolean refillsEmpty = move.getTargets().size() > 0;
+        if (!drawAllowed(p) || (p.getCardsIn(ZoneType.Library).isEmpty() && !refillsEmpty))
+            return result(p, "blessing-draw", false, "cannot safely draw after resolution");
+        if (!refillsEmpty && p.getCardsIn(ZoneType.Library).size() > 8
+                && p.getCardsIn(ZoneType.Hand).size() > 3)
+            return result(p, "blessing-reserve", false, "no useful recycling; preserve mana for engine/answers");
+        return result(p, "blessing-recycle", true, "return own threats/answers then cantrip; zero cards allowed when digging");
+    }
+    private static int recycleValue(Card c) {
+        return switch(c.getName()) {
+            case "Atraxa, Grand Unifier" -> 100;
+            case "Ancestral Recall", "Time Walk" -> 90;
+            case "Oath of Druids" -> 80;
+            case "Force of Will", "Force of Negation", "Mindbreak Trap" -> 70;
+            default -> c.isLand() ? 0 : 20;
+        };
+    }
+    public static boolean trap(Player p, SpellAbility sa) {
+        sa.resetTargets();
+        List<SpellAbility> targets = new ArrayList<>();
+        for (var item : p.getGame().getStack()) {
+            SpellAbility spell = item.getSpellAbility();
+            if (spell.isSpell() && spell.getActivatingPlayer() != null
+                    && spell.getActivatingPlayer().isOpponentOf(p) && sa.canTarget(spell)) targets.add(spell);
+        }
+        boolean urgent = targets.stream().anyMatch(s -> threat(s) >= 60);
+        if (targets.isEmpty() || (!urgent && targets.size() < 2))
+            return result(p, "trap-reserve", false, "no enemy spell, or only one low-impact spell; never cast for zero targets");
+        targets.sort(Comparator.comparingInt(VintageCardRules::threat).reversed());
+        for (SpellAbility spell : targets) sa.getTargets().add(spell);
+        return result(p, "trap-exile", sa.isTargetNumberValid(), "exile all legal enemy spells including copies; never own spells or abilities");
+    }
+    private static int threat(SpellAbility sa) {
+        if (sa.getHostCard().isFaceDown()) return 10;
+        String n = sa.getHostCard().getName();
+        if (List.of("Doomsday", "Thassa's Oracle", "Ancestral Recall", "Time Walk", "Oath of Druids",
+                "Null Rod", "Archon of Emeria", "Clarion Conqueror", "Sphere of Resistance", "Trinisphere").contains(n)) return 100;
+        if (sa.getApi() != null && List.of("Counter", "Destroy", "DestroyAll", "DealDamage", "DamageAll", "ChangeZone", "Sacrifice", "SacrificeAll").contains(sa.getApi().name())) return 75;
+        return sa.getHostCard().getCMC() >= 3 ? 60 : 10;
+    }
+}
diff --git a/forge-ai/src/main/java/forge/ai/vintage/VintageConsultation.java b/forge-ai/src/main/java/forge/ai/vintage/VintageConsultation.java
new file mode 100644
index 0000000..0eec41f
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/vintage/VintageConsultation.java
@@ -0,0 +1,108 @@
+package forge.ai.vintage;
+
+import forge.ai.ComputerUtilMana;
+import forge.card.mana.ManaCost;
+import forge.card.mana.ManaCostParser;
+import forge.deck.VintageSolo.Archetype;
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.mana.ManaCostBeingPaid;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import java.util.List;
+
+/** Oracle first, Consultation only above its win trigger. No concealed cards inspected. */
+public final class VintageConsultation {
+    private VintageConsultation() { }
+    public static boolean enabled(Player p) {
+        return VintageStrategy.enabled(p) && VintageStrategy.profile(p) == Archetype.DOOMSDAY;
+    }
+    public static String absentName(Player p) {
+        // Registered composition, not the hidden library. These names also avoid our tokens.
+        for (String name : List.of("Ugin, the Spirit Dragon", "Mountain", "Forest"))
+            if (p.getRegisteredPlayer().getDeck().getMain().countByName(name) == 0) return name;
+        return null;
+    }
+    public static String name(Player p, SpellAbility sa) {
+        return enabled(p) && sa.getHostCard().getName().equals("Demonic Consultation") ? absentName(p) : null;
+    }
+    private static boolean oracleAbility(Player p, SpellAbility sa) {
+        if (sa == null || sa.isSpell() || !p.equals(sa.getActivatingPlayer())
+                || !sa.getHostCard().getName().equals("Thassa's Oracle")) return false;
+        for (SpellAbility part = sa; part != null; part = part.getSubAbility())
+            if (part.getApi() == ApiType.WinsGame) return true;
+        return false;
+    }
+    public static boolean respondToOwnTrigger(Player p, SpellAbility top) {
+        return enabled(p) && oracleAbility(p, top);
+    }
+    private static boolean locked(Player p) {
+        // Conservative: taxes and multi-spell limits need a different joint payment plan.
+        for (String n : List.of("Torpor Orb", "Hushbringer", "Hushwing Gryff", "Dress Down",
+                "Humility", "Archon of Emeria", "Rule of Law", "Deafening Silence", "Eidolon of Rhetoric",
+                "Ethersworn Canonist", "Sphere of Resistance", "Thorn of Amethyst", "Trinisphere",
+                "Thalia, Guardian of Thraben", "Vexing Bauble", "Lavinia, Azorius Renegade",
+                "Angel's Grace", "Platinum Angel", "Gideon of the Trials"))
+            if (VintageCardRules.publicCard(p, n)) return true;
+        return false;
+    }
+    private static Card inHand(Player p, String n) {
+        return p.getCardsIn(ZoneType.Hand).stream().filter(c -> c.getName().equals(n)).findFirst().orElse(null);
+    }
+    private static boolean protectedWindow(Player p) {
+        // Even a tapped-out opponent may hold Force: only an empty hand is clearly safe.
+        if (p.getOpponents().stream().allMatch(o -> o.getCardsIn(ZoneType.Hand).isEmpty())) return true;
+        Card force = inHand(p, "Force of Will");
+        return force != null && p.getLife() > 1 && p.getCardsIn(ZoneType.Hand).stream().anyMatch(c ->
+                c != force && c.isBlue() && !c.getName().equals("Thassa's Oracle"));
+    }
+    public static boolean canStart(Player p, SpellAbility oracle) {
+        if (!enabled(p) || locked(p) || absentName(p) == null || !protectedWindow(p)
+                || !p.getGame().getStack().isEmpty()) return false;
+        Card consultation = inHand(p, "Demonic Consultation");
+        if (consultation == null) return false;
+        SpellAbility consult = consultation.getFirstSpellAbility().copy();
+        consult.setActivatingPlayer(p);
+        // Check the JOINT colored budget in both spell contexts, excluding sources restricted
+        // to creatures or artifacts. The actual two payments are still made by Forge.
+        ManaCostBeingPaid joint = new ManaCostBeingPaid(new ManaCost(new ManaCostParser("U U B")));
+        return ComputerUtilMana.canPayManaCost(joint, oracle, p, false)
+                && ComputerUtilMana.canPayManaCost(joint, consult, p, false);
+    }
+    public static Boolean choose(Player p, SpellAbility sa) {
+        if (!enabled(p)) return null;
+        String n = sa.getHostCard().getName();
+        if (n.equals("Demonic Consultation")) {
+            boolean play = !locked(p) && absentName(p) != null && !p.getCardsIn(ZoneType.Library).isEmpty()
+                    && !p.getGame().getStack().isEmpty()
+                    && oracleAbility(p, p.getGame().getStack().peekAbility()) && protectedWindow(p);
+            VintageStrategy.log(p, "consultation-window", play
+                    ? "exile library above resolved Oracle's win trigger; name " + absentName(p)
+                    : "hold: need own Oracle win trigger on top, protection and no public lock");
+            return play;
+        }
+        if (!p.getGame().getStack().isEmpty() && oracleAbility(p, p.getGame().getStack().peekAbility())
+                && sa.getApi() != ApiType.Counter) return false; // no cantrip between Oracle and Consultation
+        // Protect either combo spell / its trigger, and our counters during that same fight.
+        if (sa.getApi() == ApiType.Counter && comboOnStack(p)) {
+            SpellAbility top = p.getGame().getStack().peekAbility();
+            if (top != null && top.getActivatingPlayer() != null && top.getActivatingPlayer().isOpponentOf(p)
+                    && top.getApi() == ApiType.Counter && top.isCounterableBy(sa) && sa.canTarget(top)) {
+                sa.resetTargets();
+                sa.getTargets().add(top);
+                VintageStrategy.log(p, "consultation-protection", "counter enemy response to combo; Forge validates costs");
+                return true;
+            }
+        }
+        return null;
+    }
+    private static boolean comboOnStack(Player p) {
+        for (var item : p.getGame().getStack()) {
+            SpellAbility sa = item.getSpellAbility();
+            if (p.equals(sa.getActivatingPlayer()) && (oracleAbility(p, sa)
+                    || (sa.isSpell() && List.of("Thassa's Oracle", "Demonic Consultation").contains(sa.getHostCard().getName())))) return true;
+        }
+        return false;
+    }
+}
diff --git a/forge-ai/src/main/java/forge/ai/vintage/VintageDoomsday.java b/forge-ai/src/main/java/forge/ai/vintage/VintageDoomsday.java
new file mode 100644
index 0000000..033a4a3
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/vintage/VintageDoomsday.java
@@ -0,0 +1,95 @@
+package forge.ai.vintage;
+
+import forge.deck.VintageSolo.Archetype;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.card.CardCollectionView;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import java.util.Comparator;
+import java.util.List;
+
+/** Conservative pass-the-turn pile. Uses deck composition, own hand and public zones.
+ * Search/order callbacks see only the options that Forge legally exposes. */
+public final class VintageDoomsday {
+    private static final List<String> PILE = List.of("Ancestral Recall", "Black Lotus", "Thassa's Oracle", "Force of Will", "Ponder");
+    private VintageDoomsday() { }
+    public static boolean inPile(Player p) {
+        return VintageStrategy.profile(p) == Archetype.DOOMSDAY && p.getCardsIn(ZoneType.Library).size() <= 5;
+    }
+    public static Boolean choose(Player p, SpellAbility sa) {
+        if (VintageStrategy.profile(p) != Archetype.DOOMSDAY) return null;
+        String n = sa.getHostCard().getName();
+
+        if (n.equals("Thassa's Oracle")) return decision(p, (p.getCardsIn(ZoneType.Library).size() <= 2 && !locked(p)) || VintageConsultation.canStart(p, sa), "Oracle win or protected Consultation window with joint UUB budget");
+        if (inPile(p)) {
+            if (n.equals("Ancestral Recall")) {
+                sa.resetTargets();
+                if (p.getCardsIn(ZoneType.Library).size() < 3 || locked(p) || !sa.canTarget(p)) return false;
+                sa.getTargets().add(p);
+                return decision(p, true, "draw Lotus, Oracle and protection from the legal pile");
+            }
+            if (List.of("Brainstorm", "Gush", "Ponder", "Preordain", "Flow State", "Dig Through Time", "Doomsday", "Demonic Tutor").contains(n))
+                return decision(p, false, "do not disturb the remaining pile or draw past the win condition");
+        }
+        if (!n.equals("Doomsday")) return null;
+        if (locked(p)) return decision(p, false, "public draw, artifact, spell or triggered-ability lock");
+        int incoming = p.getOpponents().getCreaturesInPlay().stream().mapToInt(c -> Math.max(0, c.getNetPower())).sum();
+        if (p.getLife() / 2 <= incoming + 2) return decision(p, false, "half-life total cannot safely pass the turn against public power");
+        boolean blueLand = p.getCardsIn(ZoneType.Battlefield).stream().anyMatch(c -> c.isLand()
+                && List.of("Underground Sea", "Undercity Sewers", "Snow-Covered Island", "Island").contains(c.getName()));
+        if (!blueLand) return decision(p, false, "need a persistent blue land for Recall next turn");
+        // Infer remaining copies from the registered public deck and known unavailable zones.
+        // Do not inspect library identities or their order before the search resolves.
+        for (String needed : PILE) {
+            int copies = p.getRegisteredPlayer().getDeck().getMain().countByName(needed);
+            for (ZoneType zone : List.of(ZoneType.Hand, ZoneType.Battlefield, ZoneType.Exile, ZoneType.Stack))
+                for (Card c : p.getCardsIn(zone)) if (c.getName().equals(needed)) copies--;
+            if (copies < 1) return decision(p, false, "required pile role unavailable: " + needed);
+        }
+        return decision(p, true, "pass-turn Recall / Lotus / Oracle / Force / Ponder pile; unknown opposing answers remain a risk");
+    }
+    private static boolean decision(Player p, boolean play, String reason) {
+        VintageStrategy.log(p, "doomsday-plan", (play ? "play: " : "hold: ") + reason);
+        return play;
+    }
+    private static boolean locked(Player p) {
+        for (String name : List.of("Null Rod", "Stony Silence", "Collector Ouphe", "Clarion Conqueror", "Vexing Bauble",
+                "Narset, Parter of Veils", "Notion Thief", "Hullbreacher", "Spirit of the Labyrinth", "Orcish Bowmasters",
+                "Archon of Emeria", "Rule of Law", "Deafening Silence", "Sphere of Resistance", "Thorn of Amethyst",
+                "Trinisphere", "Thalia, Guardian of Thraben", "Torpor Orb", "Hushbringer", "Dress Down"))
+            if (VintageCardRules.publicCard(p, name)) return true;
+        return false;
+    }
+    private static final java.util.Map<SpellAbility, java.util.List<String>> selections = new java.util.WeakHashMap<>();
+    public static synchronized Card search(CardCollection options, SpellAbility source) {
+        java.util.List<String> chosen = selections.computeIfAbsent(source, key -> new java.util.ArrayList<>());
+        Card result = null;
+        for (String name : PILE) {
+            if (chosen.contains(name)) continue;
+            for (Card c : options) if (c.getName().equals(name)) { result = c; break; }
+            if (result != null) break;
+        }
+        if (result == null) result = options.getFirst();
+        chosen.add(result.getName());
+        if (chosen.size() >= 5) selections.remove(source);
+        return result;
+    }
+    public static CardCollectionView order(Player p, CardCollectionView cards, ZoneType destination, SpellAbility source) {
+        if (!VintageStrategy.enabled(p) || VintageStrategy.profile(p) != Archetype.DOOMSDAY
+                || source == null || !source.getHostCard().getName().equals("Doomsday") || destination != ZoneType.Library) return null;
+        CardCollection result = new CardCollection(cards);
+        // RearrangeTopOfLibraryEffect inserts EACH card at index zero: return bottom first.
+        result.sort(Comparator.comparingInt((Card c) -> PILE.indexOf(c.getName())).reversed());
+        VintageStrategy.log(p, "doomsday-order", "top first: Recall, Lotus, Oracle, Force, Ponder");
+        return result;
+    }
+    public static VintageStrategy.Priority priority(Player p, SpellAbility sa) {
+        String n = sa.getHostCard().getName();
+        int value = n.equals("Thassa's Oracle") && (inPile(p) || VintageConsultation.canStart(p, sa)) ? 120
+                : n.equals("Ancestral Recall") && inPile(p) ? 110
+                : n.equals("Doomsday") ? 70 : n.equals("Gitaxian Probe") ? 65 : 0;
+        return new VintageStrategy.Priority(value, "doomsday-sequence", "protection and legal pile progression");
+    }
+}
