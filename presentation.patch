@@ -0,0 +1,88 @@
+package forge.game.mana;
+
+import forge.ai.AITest;
+import forge.ai.vintage.VintageCardRules;
+import forge.deck.VintageSolo;
+import forge.game.Game;
+import forge.game.ability.AbilityUtils;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+import org.testng.Assert;
+import org.testng.annotations.Test;
+import java.util.List;
+
+public class VintageCardsRegressionTest extends AITest {
+    private Player setup(Game game, VintageSolo.Archetype type) {
+        Player p = game.getPlayers().get(1);
+        VintageSolo.configure(p.getRegisteredPlayer().getDeck(), type, true);
+        return p;
+    }
+    private SpellAbility spell(String name, Player p) {
+        SpellAbility sa = addCardToZone(name, p, ZoneType.Hand).getFirstSpellAbility();
+        sa.setActivatingPlayer(p);
+        return sa;
+    }
+    @Test public void probeCantripsAgainstEmptyHandButNeverEmptyLibrary() {
+        Game game = initAndCreateGame();
+        Player p = setup(game, VintageSolo.Archetype.OATH);
+        SpellAbility probe = spell("Gitaxian Probe", p);
+        Assert.assertFalse(VintageCardRules.choose(p, probe));
+        addCardToZone("Island", p, ZoneType.Library);
+        Assert.assertTrue(VintageCardRules.choose(p, probe));
+        Assert.assertEquals(probe.getTargets().getTargetPlayers().iterator().next(), p.getWeakestOpponent());
+        AbilityUtils.resolve(probe);
+        Assert.assertEquals(p.getCardsIn(ZoneType.Library).size(), 0);
+        Assert.assertTrue(p.getCardsIn(ZoneType.Hand).stream().anyMatch(c -> c.getName().equals("Island")));
+    }
+    @Test public void probeRespectsPublicDrawLock() {
+        Game game = initAndCreateGame();
+        Player p = setup(game, VintageSolo.Archetype.OATH);
+        addCardToZone("Island", p, ZoneType.Library);
+        addCard("Narset, Parter of Veils", p.getWeakestOpponent());
+        Assert.assertFalse(VintageCardRules.choose(p, spell("Gitaxian Probe", p)));
+    }
+    @Test public void blessingRecyclesOwnAtraxaAndDrawsWithoutReplenishingOpponent() {
+        Game game = initAndCreateGame();
+        Player p = setup(game, VintageSolo.Archetype.OATH);
+        addCardToZone("Atraxa, Grand Unifier", p, ZoneType.Graveyard);
+        addCardToZone("Time Walk", p.getWeakestOpponent(), ZoneType.Graveyard);
+        SpellAbility sa = spell("Gaea's Blessing", p);
+        Assert.assertTrue(VintageCardRules.choose(p, sa));
+        Assert.assertEquals(sa.getTargets().getTargetPlayers().iterator().next(), p);
+        Assert.assertEquals(sa.getSubAbility().getTargets().getTargetCards().get(0).getName(), "Atraxa, Grand Unifier");
+        AbilityUtils.resolve(sa);
+        Assert.assertEquals(p.getWeakestOpponent().getCardsIn(ZoneType.Graveyard).size(), 1);
+        Assert.assertTrue(p.getCardsIn(ZoneType.Hand).stream().anyMatch(c -> c.getName().equals("Atraxa, Grand Unifier")));
+    }
+    @Test public void trapNeverCastsOnEmptyStackAndExilesMultipleEnemySpells() {
+        Game game = initAndCreateGame();
+        Player p = setup(game, VintageSolo.Archetype.OATH);
+        SpellAbility trap = spell("Mindbreak Trap", p);
+        Assert.assertFalse(VintageCardRules.choose(p, trap));
+        SpellAbility recall = spell("Ancestral Recall", p.getWeakestOpponent());
+        recall.getTargets().add(p.getWeakestOpponent());
+        recall.setHostCard(game.getAction().moveToStack(recall.getHostCard(), recall));
+        game.getStack().add(recall);
+        SpellAbility walk = spell("Time Walk", p.getWeakestOpponent());
+        walk.setHostCard(game.getAction().moveToStack(walk.getHostCard(), walk));
+        game.getStack().add(walk);
+        Assert.assertTrue(VintageCardRules.choose(p, trap));
+        Assert.assertEquals(trap.getTargets().size(), 2);
+        AbilityUtils.resolve(trap);
+        Assert.assertEquals(p.getWeakestOpponent().getCardsIn(ZoneType.Exile).size(), 2);
+    }
+    @Test public void doomsdaySelectsFiveDifferentRolesAndOrdersRecallFirst() {
+        Game game = initAndCreateGame();
+        Player p = setup(game, VintageSolo.Archetype.DOOMSDAY);
+        for (String name : List.of("Ponder", "Ponder", "Force of Will", "Force of Will", "Thassa's Oracle",
+                "Thassa's Oracle", "Black Lotus", "Ancestral Recall", "Island", "Dark Ritual"))
+            addCardToZone(name, p, ZoneType.Library);
+        SpellAbility doom = spell("Doomsday", p);
+        AbilityUtils.resolve(doom);
+        Assert.assertEquals(p.getCardsIn(ZoneType.Library).stream().map(c -> c.getName()).toList(),
+                List.of("Ancestral Recall", "Black Lotus", "Thassa's Oracle", "Force of Will", "Ponder"));
+        Assert.assertEquals(p.getLife(), 10);
+        Assert.assertEquals(p.getCardsIn(ZoneType.Exile).size(), 5);
+    }
+}
