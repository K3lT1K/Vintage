+++ b/forge-gui-desktop/src/test/java/forge/gui/download/VintageImagesRegressionTest.java
@@ -0,0 +1,71 @@
+package forge.gui.download;
+
+import forge.ai.AITest;
+import forge.deck.VintageSolo;
+import forge.deck.io.DeckSerializer;
+import forge.item.PaperCard;
+import forge.localinstance.properties.ForgeConstants;
+import org.testng.Assert;
+import org.testng.annotations.Test;
+import java.io.File;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.Map;
+
+/** Builds the real missing-image plan without any network access. */
+public class VintageImagesRegressionTest extends AITest {
+    private static class DeckImages extends GuiDownloadFilteredCardImages {
+        DeckImages(Set<PaperCard> cards) { super(cards, Set.of("c_1_1_spirit", "undercity")); }
+        @Override protected void reportStatus(String message) { /* No UI in this offline plan test. */ }
+        Map<String,String> plan() throws Exception { return getNeededFiles(); }
+    }
+    @Test(timeOut = 30000) public void fourDecksProduceSmallExactImagePlanWithoutBulkSync() throws Exception {
+        Set<PaperCard> cards = new LinkedHashSet<>();
+        for (VintageSolo.Archetype a : VintageSolo.Archetype.values())
+            for (var entry : DeckSerializer.fromFile(new File(ForgeConstants.RES_DIR + "vintage-solo/" + a.file + ".dck")).getMain())
+                cards.add(entry.getKey());
+        Assert.assertEquals(cards.stream().map(c -> c.getName()).distinct().count(), 84L);
+        Map<String,String> plan = new DeckImages(cards).plan();
+        Assert.assertFalse(plan.isEmpty());
+        Assert.assertTrue(plan.size() <= 100, "Unexpected collection-wide download: " + plan.size());
+        Assert.assertTrue(plan.values().stream().noneMatch(u -> u.contains("bulk-data") || u.endsWith(".zip")));
+        // A previously downloaded file must not be queued on a second pass.
+        File cached = new File(plan.keySet().iterator().next());
+        Assert.assertTrue(cached.getParentFile().isDirectory() || cached.getParentFile().mkdirs());
+        Assert.assertTrue(cached.createNewFile());
+        try {
+            Assert.assertTrue(new DeckImages(cards).plan().containsKey(cached.getAbsolutePath()), "empty download must retry");
+            java.nio.file.Files.writeString(cached.toPath(), "<html>This is an error response, not a card image.</html>");
+            Assert.assertTrue(new DeckImages(cards).plan().containsKey(cached.getAbsolutePath()));
+            java.nio.file.Files.write(cached.toPath(), java.util.Arrays.copyOf(png(), 40));
+            Assert.assertTrue(new DeckImages(cards).plan().containsKey(cached.getAbsolutePath()), "truncated PNG must retry");
+            java.nio.file.Files.write(cached.toPath(), png());
+            Assert.assertTrue(GuiDownloadFilteredCardImages.isUsableImage(cached));
+            Assert.assertFalse(new DeckImages(cards).plan().containsKey(cached.getAbsolutePath()));
+        }
+        finally { Assert.assertTrue(cached.delete()); }
+    }
+
+    private byte[] png() {
+        return java.util.Base64.getDecoder().decode("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+a2ioAAAAASUVORK5CYII=");
+    }
+    @Test public void downloadRefreshRecoversPreviouslyMissingEditionAndPaperCard() throws Exception {
+        PaperCard card = forge.model.FModel.getMagicDb().getCommonCards().getCard("Black Lotus", "LEA");
+        String key = forge.util.ImageUtil.getImageKey(card, "", true);
+        File file = new File(ForgeConstants.CACHE_CARD_PICS_DIR, key + ".jpg");
+        Assert.assertFalse(file.exists(), "isolated image-cache fixture required");
+        forge.ImageKeys.refreshDownloadedImages();
+        Assert.assertFalse(card.hasImage(true));
+        Assert.assertTrue(file.getParentFile().isDirectory() || file.getParentFile().mkdirs());
+        try {
+            java.nio.file.Files.write(file.toPath(), png());
+            forge.ImageKeys.refreshDownloadedImages();
+            Assert.assertTrue(card.hasImage(true));
+            Assert.assertNotNull(forge.ImageKeys.getImageFile(key));
+        } finally {
+            java.nio.file.Files.deleteIfExists(file.toPath());
+            forge.ImageKeys.refreshDownloadedImages();
+            card.hasImage(true);
+        }
+    }
+}
