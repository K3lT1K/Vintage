+#!/usr/bin/env python3
+"""Package gate: signature, launcher, DEX, native code and exact offline resources.
+Does not claim device launch, a completed game or verified AI behavior.
+"""
+import hashlib
+import os
+import pathlib
+import shutil
+import subprocess
+import tempfile
+import zipfile
+
+root = pathlib.Path(__file__).resolve().parents[2]
+reports = root / 'tools/vintage-solo/reports'
+reports.mkdir(parents=True, exist_ok=True)
+dist = root / 'dist/vintage-solo'
+dist.mkdir(parents=True, exist_ok=True)
+# A failed verification must not leave an old installable deliverable behind.
+for name in ('vintage-solo.apk', 'SHA256SUMS', 'verification.txt'):
+    (dist / name).unlink(missing_ok=True)
+sdk = pathlib.Path(os.environ['ANDROID_SDK_ROOT']) / 'build-tools/35.0.0'
+source_bundle = root / 'forge-gui-android/assets/vintage-res.zip'
+source_version = (root / 'forge-gui-android/assets/vintage-res.version').read_bytes()
+with source_bundle.open('rb') as stream:
+    source_hash = hashlib.file_digest(stream, 'sha256').hexdigest()
+expected_resources = {
+    'res/' + p.relative_to(root / 'forge-gui/res').as_posix()
+    for p in (root / 'forge-gui/res').rglob('*') if p.is_file() and p.suffix != '.xcf'
+}
+verified = []
+verification = []
+for apk in sorted((root / 'forge-gui-android/target').rglob('*.apk')):
+    signature = subprocess.run([str(sdk / 'apksigner'), 'verify', '--verbose', '--print-certs', str(apk)],
+                               capture_output=True, text=True)
+    if signature.returncode:
+        continue  # Unsigned intermediate is never copied to dist.
+    manifest = subprocess.check_output([str(sdk / 'aapt'), 'dump', 'badging', str(apk)], text=True)
+    assert "package: name='forge.vintage.solo'" in manifest, f'Wrong package: {apk}'
+    assert "launchable-activity: name='forge.app.Launcher'" in manifest, f'Missing launcher: {apk}'
+    with zipfile.ZipFile(apk) as package:
+        assert package.testzip() is None, f'Corrupt APK ZIP: {apk}'
+        assert 'classes.dex' in package.namelist(), 'Missing executable DEX'
+        assert any(n.startswith('lib/') and n.endswith('/libgdx.so') for n in package.namelist()), 'Missing LibGDX native code'
+        assert package.read('assets/vintage-res.version') == source_version, 'Wrong resource version'
+        with tempfile.TemporaryFile() as temporary:
+            with package.open('assets/vintage-res.zip') as bundled:
+                shutil.copyfileobj(bundled, temporary)
+            temporary.seek(0)
+            assert hashlib.file_digest(temporary, 'sha256').hexdigest() == source_hash, 'APK bundle differs from built resources'
+            temporary.seek(0)
+            with zipfile.ZipFile(temporary) as resources:
+                assert resources.testzip() is None, 'Corrupt offline resources'
+                assert set(resources.namelist()) == expected_resources, 'Missing or unexpected offline resources'
+    verified.append(apk)
+    verification.append(str(apk.relative_to(root)) + '\n' + signature.stdout + '\n' + manifest)
+assert verified, 'No signed APK passed verification'
+chosen = verified[-1]
+output = dist / 'vintage-solo.apk'
+shutil.copyfile(chosen, output)
+with output.open('rb') as stream:
+    digest = hashlib.file_digest(stream, 'sha256').hexdigest()
+(dist / 'SHA256SUMS').write_text(digest + '  vintage-solo.apk\n')
+status = ('Signature, package, launcher declaration, DEX, native code, offline resource integrity: PASS\n'
+          'Device launch: NOT TESTED\nFull game: NOT TESTED\nSpecialized AI behavior: NOT TESTED\n')
+(dist / 'verification.txt').write_text(status + '\n' + '\n'.join(verification))
+(reports / 'apk.txt').write_text(str(output.relative_to(root)) + '\n' + status)
+print(status + str(output))
