+++ b/.github/workflows/vintage-android.yml
@@ -0,0 +1,48 @@
+name: Vintage Solo APK
+on:
+  workflow_dispatch:
+  push:
+    branches: ['codex/vintage-apk']
+permissions:
+  contents: read
+jobs:
+  apk:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 90
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+      - name: Install local pinned tools
+        env:
+          ACCEPT_ANDROID_SDK_LICENSES: 'yes'
+          ANDROID_SDK_ROOT: ${{ runner.temp }}/vintage-sdk
+        run: |
+          mkdir -p tools/vintage-solo/reports
+          bash tools/vintage-solo/bootstrap.sh 2>&1 | tee tools/vintage-solo/reports/bootstrap.log
+      - name: Build with offline resources
+        run: |
+          source .vintage-tools/env.sh
+          command -v Xvfb
+          xvfb-run -a bash tools/vintage-solo/build.sh 2>&1 | tee tools/vintage-solo/reports/build.log
+      - name: Verify signed APK and offline resources
+        run: |
+          source .vintage-tools/env.sh
+          python3 tools/vintage-solo/check_apk.py
+      - name: Upload verified APK only
+        uses: actions/upload-artifact@v4
+        with:
+          name: vintage-solo-apk
+          if-no-files-found: error
+          path: dist/vintage-solo/
+      - name: Upload diagnostics
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: vintage-solo-diagnostics
+          if-no-files-found: warn
+          path: |
+            tools/vintage-solo/reports/**
+            HANDOFF.md
