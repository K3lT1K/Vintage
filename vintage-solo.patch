@@ -0,0 +1,120 @@
+package forge.ai.vintage;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Bounded London-mulligan search, not a mana-payment or MTG rules engine.
+ * Opening estimates are deliberately conservative; in-game payment remains Forge's job. */
+public final class OpeningHandPlanner {
+    public record OpeningCard(String name, int cmc, boolean land, boolean creature,
+                              boolean artifact, boolean white, boolean blue, boolean green) { }
+    public record Choice(List<Integer> bottom, int score, boolean keep, String reason) { }
+    private OpeningHandPlanner() { }
+
+    public static Choice choose(String profile, List<OpeningCard> hand, int returnCount) {
+        if (hand.size() > 10 || returnCount < 0 || returnCount > hand.size()) {
+            throw new IllegalArgumentException("Expected at most ten cards and a valid bottom count");
+        }
+        int keepCount = hand.size() - returnCount;
+        int bestScore = Integer.MIN_VALUE;
+        int bestMask = 0;
+        for (int mask = 0; mask < (1 << hand.size()); mask++) {
+            if (Integer.bitCount(mask) != keepCount) { continue; }
+            List<OpeningCard> kept = new ArrayList<>();
+            for (int i = 0; i < hand.size(); i++) {
+                if ((mask & (1 << i)) != 0) { kept.add(hand.get(i)); }
+            }
+            int score = score(profile, kept);
+            if (score > bestScore) { bestScore = score; bestMask = mask; }
+        }
+        List<Integer> bottom = new ArrayList<>();
+        for (int i = 0; i < hand.size(); i++) {
+            if ((bestMask & (1 << i)) == 0) { bottom.add(i); }
+        }
+        // At four cards stop trading away resources. This is a policy, not a strength claim.
+        int threshold = switch (profile) { case "INITIATIVE" -> 44; case "WORKSHOP" -> 42; default -> 42; };
+        return new Choice(List.copyOf(bottom), bestScore, keepCount <= 4 || bestScore >= threshold,
+                "London: retained-hand mana, colours, threats and engine; score=" + bestScore);
+    }
+
+    private static int count(List<OpeningCard> hand, String name) {
+        return (int) hand.stream().filter(c -> c.name().equals(name)).count();
+    }
+
+    public static int score(String profile, List<OpeningCard> hand) {
+        int lands = 0, white = 0, blue = 0, green = 0, rocks = 0, mana = 0;
+        int threats = 0, bluePitch = 0, imprint = 0, expensive = 0;
+        List<Integer> landMana = new ArrayList<>();
+        for (OpeningCard c : hand) {
+            String n = c.name();
+            boolean land = c.land() || n.equals("Witch Enchanter");
+            if (land) {
+                lands++;
+                int amount = switch (n) {
+                    case "Mishra's Workshop" -> profile.equals("WORKSHOP") ? 3 : 0;
+                    case "Ancient Tomb" -> 2;
+                    // Cannot count Academy without artifacts, or Saga's chapter before it resolves.
+                    case "Tolarian Academy", "Urza's Saga" -> 0;
+                    default -> 1;
+                };
+                landMana.add(amount);
+                if (n.equals("Plains") || n.equals("Karakas") || n.equals("Cavern of Souls")
+                        || n.equals("Witch Enchanter") || n.equals("Forbidden Orchard")) { white++; }
+                if (n.equals("Tropical Island") || n.equals("Volcanic Island") || n.equals("Hedge Maze")
+                        || n.equals("Thundering Falls") || n.equals("Forbidden Orchard") || n.equals("Island")
+                        || n.equals("Misty Rainforest") || n.equals("Scalding Tarn") || n.equals("Polluted Delta")) { blue++; }
+                if (n.equals("Tropical Island") || n.equals("Hedge Maze") || n.equals("Forbidden Orchard")
+                        || n.equals("Boseiju, Who Endures") || n.equals("Misty Rainforest")
+                        || n.equals("Scalding Tarn") || n.equals("Polluted Delta")) { green++; }
+            } else {
+                if (c.blue() && !n.equals("Force of Will")) { bluePitch++; }
+                if (!c.artifact() && c.white()) { imprint++; }
+                if (c.creature() && c.cmc() <= 4) { threats++; }
+                if (c.cmc() >= 6 && !n.equals("Dig Through Time") && !n.equals("Treasure Cruise")) { expensive++; }
+                if (n.startsWith("Mox ")) {
+                    rocks++; mana++;
+                    if (n.equals("Mox Pearl")) { white++; }
+                    if (n.equals("Mox Sapphire")) { blue++; }
+                    if (n.equals("Mox Emerald")) { green++; }
+                }
+                if (n.equals("Mana Crypt")) { rocks++; mana += 2; }
+                if (n.equals("Black Lotus")) { rocks++; mana += 3; white++; blue++; green++; }
+            }
+        }
+        landMana.sort(java.util.Comparator.reverseOrder());
+        // Two-turn development estimate; do not pretend both lands can be played on turn one.
+        for (int i = 0; i < Math.min(2, landMana.size()); i++) { mana += landMana.get(i); }
+        int chrome = Math.min(count(hand, "Chrome Mox"), Math.max(0, imprint - 1));
+        mana += chrome; white += chrome;
+        if (count(hand, "Sol Ring") > 0 && mana > 0) { mana++; rocks++; }
+        int score = Math.min(mana, 4) * 8 + Math.min(lands, 2) * 4;
+        if (lands == 0) { score -= 28; }
+        score -= Math.max(0, lands - 3) * 9;
+        switch (profile) {
+            case "INITIATIVE":
+                score += Math.min(threats, 2) * 9;
+                if (white == 0 || mana < 3) { score -= 36; }
+                if (count(hand, "White Plume Adventurer") + count(hand, "Seasoned Dungeoneer") > 0) { score += 8; }
+                score -= Math.max(0, expensive - (chrome > 0 ? 1 : 0)) * 9;
+                break;
+            case "WORKSHOP":
+                score += Math.min(threats, 2) * 8;
+                if (mana < 2 || threats == 0) { score -= 30; }
+                if (count(hand, "Mishra's Workshop") > 0) { score += 8; }
+                if (count(hand, "Sphere of Resistance") > 0 && threats > 0) { score += 6; }
+                break;
+            default:
+                int oath = count(hand, "Oath of Druids");
+                if (oath > 0 && green > 0 && mana >= 2) { score += 18; }
+                if (oath > 0 && count(hand, "Forbidden Orchard") > 0) { score += 9; }
+                if (count(hand, "Force of Will") > 0 && bluePitch > 0) { score += 10; }
+                if (blue == 0 || mana < 2) { score -= 30; }
+                if (oath == 0 && count(hand, "Stock Up") + count(hand, "Brainstorm")
+                        + count(hand, "Ancestral Recall") == 0) { score -= 15; }
+                score -= expensive * 16; // Prefer returning Atraxa to the library, never inspect its order.
+                score -= Math.max(0, oath - 1) * 8;
+                break;
+        }
+        return score;
+    }
+}
diff --git a/forge-ai/src/main/java/forge/ai/vintage/VintageRemoval.java b/forge-ai/src/main/java/forge/ai/vintage/VintageRemoval.java
