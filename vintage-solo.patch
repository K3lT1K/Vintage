@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""54 real games per seed: nine ordered matchups x both first players x three bot assignments.
+Baseline (-1) means both original bots; 0/1 means specialist in that seat.
+Every game has its own JVM and timeout. No timeout/error is counted as a draw.
+"""
+import argparse, collections, csv, itertools, json, pathlib, subprocess
+p=argparse.ArgumentParser()
+p.add_argument('--jar',required=True,help='Built desktop jar-with-dependencies')
+p.add_argument('--seeds',nargs='+',type=int,default=[101,202,303])
+p.add_argument('--timeout',type=int,default=180)
+p.add_argument('--output',default='tools/vintage-solo/reports/benchmark')
+a=p.parse_args();root=pathlib.Path(__file__).resolve().parents[2]; jar=pathlib.Path(a.jar).resolve()
+assert jar.is_file(), f'Build Forge first: {jar}'
+out=pathlib.Path(a.output).resolve();out.mkdir(parents=True,exist_ok=True)
+rows=[]
+for d0,d1,first,seed,specialist in itertools.product(['INITIATIVE','WORKSHOP','OATH'],['INITIATIVE','WORKSHOP','OATH'],range(2),a.seeds,[-1,0,1]):
+    result=out/f'{d0}-{d1}-{first}-{seed}-{specialist}.tsv'
+    result.unlink(missing_ok=True)
+    command=['java','-Xmx2g','-Djava.awt.headless=true','-Dforge.vintage.assets='+str(root/'forge-gui')+'/','-jar',str(jar),'vintage-bench',d0,d1,str(specialist),str(first),str(seed),str(result)]
+    status='ERROR';winner=None
+    with result.with_suffix('.stdout.log').open('w') as log:
+        try:
+            process=subprocess.run(command,cwd=root,stdout=log,stderr=subprocess.STDOUT,timeout=a.timeout)
+            if process.returncode==0 and result.exists():
+                parts=result.read_text().strip().split('\t');status=parts[0]
+                if status=='COMPLETE': winner=int(parts[1])
+        except subprocess.TimeoutExpired: status='TIMEOUT'
+    row=dict(deck0=d0,deck1=d1,first=first,seed=seed,specialist=specialist,status=status,winner=winner)
+    rows.append(row)
+    (out/'games.json').write_text(json.dumps(rows,indent=2)+'\n')
+    print(row,flush=True)
+summary={}
+for d0,d1 in itertools.product(['INITIATIVE','WORKSHOP','OATH'],repeat=2):
+    subset=[r for r in rows if r['deck0']==d0 and r['deck1']==d1]
+    counts=collections.Counter(r['status'] for r in subset)
+    enhanced=[r for r in subset if r['specialist']>=0 and r['status']=='COMPLETE']
+    counts.update(specialist_wins=sum(r['winner']==r['specialist'] for r in enhanced),baseline_wins=sum(r['winner']>=0 and r['winner']!=r['specialist'] for r in enhanced),draws=sum(r['winner']==-1 for r in enhanced))
+    summary[d0+' / '+d1]=dict(counts)
+(out/'summary.json').write_text(json.dumps(summary,indent=2)+'\n')
+print(json.dumps(summary,indent=2))
