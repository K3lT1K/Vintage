+#!/usr/bin/env bash
+# Local tools only; no apt, sudo, or implicit network-policy workarounds.
+set -euo pipefail
+TOOLS_DIR="${VINTAGE_TOOLS_DIR:-$PWD/.vintage-tools}"
+mkdir -p "$TOOLS_DIR"
+TOOLS_DIR="$(cd "$TOOLS_DIR" && pwd)"
+MAVEN_VERSION=3.8.1
+MAVEN_URL="https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz"
+if [ ! -x "$TOOLS_DIR/apache-maven-$MAVEN_VERSION/bin/mvn" ]; then
+  curl --fail --location "$MAVEN_URL" -o "$TOOLS_DIR/maven.tar.gz"
+  curl --fail --location "$MAVEN_URL.sha512" -o "$TOOLS_DIR/maven.sha512"
+  python3 - "$TOOLS_DIR" <<'PY'
+import hashlib, pathlib, sys
+p=pathlib.Path(sys.argv[1])
+expected=(p/'maven.sha512').read_text().split()[0].lower()
+assert hashlib.sha512((p/'maven.tar.gz').read_bytes()).hexdigest()==expected, 'Maven checksum mismatch'
+PY
+  tar -xzf "$TOOLS_DIR/maven.tar.gz" -C "$TOOLS_DIR"
+fi
+SDK_DIR="${ANDROID_SDK_ROOT:-$TOOLS_DIR/android-sdk}"
+mkdir -p "$SDK_DIR"
+SDK_DIR="$(cd "$SDK_DIR" && pwd)"
+# Fixed command-line tools revision compatible with JDK 17.
+if [ ! -x "$SDK_DIR/cmdline-tools/12.0/bin/sdkmanager" ]; then
+  curl --fail --location https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -o "$TOOLS_DIR/android-cli.zip"
+  mkdir -p "$TOOLS_DIR/cli-unpack" "$SDK_DIR/cmdline-tools"
+  unzip -q -o "$TOOLS_DIR/android-cli.zip" -d "$TOOLS_DIR/cli-unpack"
+  mv "$TOOLS_DIR/cli-unpack/cmdline-tools" "$SDK_DIR/cmdline-tools/12.0"
+fi
+SDKMANAGER="$SDK_DIR/cmdline-tools/12.0/bin/sdkmanager"
+# Caller must explicitly accept Android SDK terms before running this script.
+if [ "${ACCEPT_ANDROID_SDK_LICENSES:-}" != yes ]; then
+  echo 'Read Android SDK terms; rerun with ACCEPT_ANDROID_SDK_LICENSES=yes if accepted.' >&2
+  exit 2
+fi
+set +o pipefail
+yes | "$SDKMANAGER" --sdk_root="$SDK_DIR" --licenses >/dev/null
+license_status=${PIPESTATUS[1]}
+set -o pipefail
+[ "$license_status" -eq 0 ]
+"$SDKMANAGER" --sdk_root="$SDK_DIR" 'platforms;android-35' 'build-tools;35.0.0' 'platform-tools'
+PLUGIN_DIR="$HOME/.m2/repository/com/simpligility/maven/plugins/android-maven-plugin/4.6.2"
+mkdir -p "$PLUGIN_DIR"
+for extension in jar pom; do
+  curl --fail --location "https://github.com/Card-Forge/android-maven-plugin/releases/download/4.6.2/android-maven-plugin-4.6.2.$extension" -o "$PLUGIN_DIR/android-maven-plugin-4.6.2.$extension"
+done
+printf 'export PATH=%q:$PATH\nexport ANDROID_SDK_ROOT=%q\n' "$TOOLS_DIR/apache-maven-$MAVEN_VERSION/bin" "$SDK_DIR" > "$TOOLS_DIR/env.sh"
+echo "Tools ready. Source $TOOLS_DIR/env.sh"
