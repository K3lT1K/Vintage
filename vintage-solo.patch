@@ -0,0 +1,33 @@
+package forge.deck;
+
+/** The fixed, public roster. No rule engine or card implementations live here. */
+public final class VintageSolo {
+    public static final String SPECIALIST = "VintageSoloSpecialist";
+    public enum Archetype {
+        INITIATIVE("initiative", "Mono-White Initiative", "Давление и инициатива"),
+        WORKSHOP("workshop", "Workshop Aggro", "Артефакты и ограничения"),
+        OATH("oath", "Oath of Druids", "Контроль и большие существа");
+        public final String file;
+        public final String title;
+        public final String plan;
+        Archetype(String file, String title, String plan) {
+            this.file = file;
+            this.title = title;
+            this.plan = plan;
+        }
+        @Override public String toString() { return title; }
+    }
+    private VintageSolo() { }
+    public static Archetype archetype(Deck deck) {
+        for (Archetype a : Archetype.values()) {
+            if (deck.getAiHints().contains("VintageSolo:" + a.name())) { return a; }
+        }
+        return null;
+    }
+    public static void configure(Deck deck, Archetype archetype, boolean specialist) {
+        deck.getAiHints().removeIf(h -> h.startsWith("VintageSolo:"));
+        deck.setAiHints("VintageSolo:" + archetype.name());
+        deck.getAiHints().remove(SPECIALIST);
+        if (specialist) { deck.setAiHints(SPECIALIST); }
+    }
+}
diff --git a/forge-core/src/main/java/forge/util/VintageResources.java b/forge-core/src/main/java/forge/util/VintageResources.java
new file mode 100644
index 00000000..f46a81ef
--- /dev/null
+++ b/forge-core/src/main/java/forge/util/VintageResources.java
@@ -0,0 +1,45 @@
+package forge.util;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+
+/** Installs the APK's resource snapshot. A failed install never writes the completion marker. */
+public final class VintageResources {
+    private VintageResources() { }
+    public static void install(InputStream input, File directory, String version) throws IOException {
+        Path root = directory.toPath().toAbsolutePath().normalize();
+        Files.createDirectories(root);
+        Path marker = root.resolve("vintage-res.version");
+        try (ZipInputStream zip = new ZipInputStream(input, StandardCharsets.UTF_8)) {
+            if (Files.isRegularFile(marker) && new String(Files.readAllBytes(marker), StandardCharsets.UTF_8).equals(version)
+                    && Files.isRegularFile(root.resolve("res/vintage-solo/oath.dck"))) { return; }
+            ZipEntry entry;
+            int files = 0;
+            while ((entry = zip.getNextEntry()) != null) {
+                Path target = root.resolve(entry.getName()).normalize();
+                if (!target.startsWith(root.resolve("res")) || entry.getName().contains("\\")) {
+                    throw new IOException("Invalid bundled resource path: " + entry.getName());
+                }
+                if (entry.isDirectory()) { Files.createDirectories(target); continue; }
+                Files.createDirectories(target.getParent());
+                Path temporary = Files.createTempFile(target.getParent(), ".install-", ".tmp");
+                try {
+                    Files.copy(zip, temporary, StandardCopyOption.REPLACE_EXISTING);
+                    Files.move(temporary, target, StandardCopyOption.REPLACE_EXISTING);
+                } finally { Files.deleteIfExists(temporary); }
+                files++;
+            }
+            if (files == 0 || !Files.isRegularFile(root.resolve("res/vintage-solo/oath.dck"))) {
+                throw new IOException("Incomplete Vintage Solo resource bundle");
+            }
+            Files.write(marker, version.getBytes(StandardCharsets.UTF_8));
+        }
+    }
+}
