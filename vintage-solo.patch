+#!/usr/bin/env python3
+"""Offline checks available without Maven/Android. Never reports gameplay success."""
+import collections, datetime, json, pathlib, re, subprocess, shutil
+ROOT=pathlib.Path(__file__).resolve().parents[2]
+OUT=ROOT/'tools/vintage-solo/reports'; OUT.mkdir(exist_ok=True)
+classes=ROOT/'tools/vintage-solo/.classes'; classes.mkdir(exist_ok=True)
+javac=['javac'] if shutil.which('javac') else ['java','--module','jdk.compiler/com.sun.tools.javac.Main']
+subprocess.run([*javac,'-encoding','UTF-8','-d',str(classes),str(ROOT/'forge-ai/src/main/java/forge/ai/vintage/OpeningHandPlanner.java'),str(ROOT/'forge-core/src/main/java/forge/util/VintageResources.java'),str(ROOT/'tools/vintage-solo/tests/LocalChecks.java'),str(ROOT/'tools/vintage-solo/tests/ParseJava.java')],check=True)
+checks=subprocess.check_output(['java','-cp',str(classes),'LocalChecks'],text=True)
+# Parse actual integration files even when Maven dependencies are unavailable.
+paths=[ROOT/p for p in '''forge-ai/src/main/java/forge/ai/vintage/VintageRemoval.java
+forge-gui-desktop/src/main/java/forge/view/VintageBenchmark.java
+forge-gui-desktop/src/main/java/forge/view/Main.java
+forge-ai/src/main/java/forge/ai/AiController.java
+forge-ai/src/main/java/forge/ai/PlayerControllerAi.java
+forge-ai/src/main/java/forge/ai/ability/CounterAi.java
+forge-ai/src/main/java/forge/ai/vintage/VintageStrategy.java
+forge-core/src/main/java/forge/deck/VintageSolo.java
+forge-gui-android/src/forge/app/Main.java
+forge-gui-mobile/src/forge/Forge.java
+forge-gui-mobile/src/forge/assets/AssetsDownloader.java
+forge-gui-mobile/src/forge/screens/home/HomeScreen.java
+forge-gui-mobile/src/forge/screens/match/MatchScreen.java
+forge-gui-mobile/src/forge/screens/vintage/VintageSoloScreen.java'''.splitlines()]
+syntax=subprocess.check_output(['java','-cp',str(classes),'ParseJava',*map(str,paths)],text=True)
+index={}
+for p in (ROOT/'forge-gui/res/cardsfolder').rglob('*.txt'):
+    data=p.read_text(encoding='utf-8-sig')
+    for name in re.findall(r'^Name:(.+)$',data,re.M): index[name.strip()]=(p,data)
+fmt=(ROOT/'forge-gui/res/formats/Sanctioned/Vintage.txt').read_text()
+def names(key): return set(re.search('^'+key+':(.+)$',fmt,re.M).group(1).split('; '))
+restricted,banned=names('Restricted'),names('Banned')
+decks={}
+for p in sorted((ROOT/'forge-gui/res/vintage-solo').glob('*.dck')):
+    cards=collections.Counter()
+    for n,name in re.findall(r'^(\d+) (.+)$',p.read_text(),re.M): cards[name]+=int(n)
+    assert sum(cards.values())==60,(p,'not 60')
+    entries=[]
+    for name,n in cards.items():
+        assert name in index,(p,name,'missing script')
+        script,data=index[name]
+        assert name not in banned,(p,name,'banned')
+        assert n <= (1 if name in restricted else 99 if name in ['Plains','Island','Swamp','Mountain','Forest'] else 4),(p,name,'count illegal')
+        entries.append(dict(name=name,count=n,script=str(script.relative_to(ROOT)),ai_removal_flag='RemAIDeck:True' in data, runtime='NOT TESTED'))
+    decks[p.stem]=dict(total=60,unique=len(cards),cards=entries)
+report=dict(review_date='2026-09-08',runtime_date=str(datetime.date.today()),upstream=(ROOT/'UPSTREAM_COMMIT.txt').read_text().strip(),local_assertions=checks.strip(),syntax=syntax.strip(),decks=decks,legality='Counts and B/R against pinned Forge data only; runtime format check also wired before match',full_games=0,apk_built=False,android_launch='NOT TESTED',bot_comparison='NOT RUN',matchups='All 9 ordered pairs, both first-player assignments: NOT RUN')
+(OUT/'local-checks.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\n')
+print(checks+syntax+'PASS three 60-card decks: scripts present and pinned Vintage B/R counts valid')
