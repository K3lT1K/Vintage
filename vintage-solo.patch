+    private final FLabel you = add(new FLabel.Builder().text("ВАША КОЛОДА").build());
+    private final FLabel opponent = add(new FLabel.Builder().text("КОЛОДА СОПЕРНИКА").build());
+    private final FComboBox<Archetype> humanDeck = add(new FComboBox<>());
+    private final FComboBox<Archetype> botDeck = add(new FComboBox<>());
+    private final FTextArea humanPlan = add(new FTextArea(false));
+    private final FTextArea botPlan = add(new FTextArea(false));
+    private final FCheckBox autoPass = add(new FCheckBox("Автопередача без действий", true));
+    private final FCheckBox textCards = add(new FCheckBox("Текстовые карты", true));
+    private final FButton start = add(new FButton("Начать партию"));
+    private final FButton help = add(new FButton("Управление"));
+    private boolean starting;
+
+    private VintageSoloScreen() {
+        super((Header) null);
+        humanDeck.setItems(Archetype.values(), Archetype.INITIATIVE);
+        botDeck.setItems(Archetype.values(), Archetype.OATH);
+        humanDeck.setChangedHandler(e -> updatePlans());
+        botDeck.setChangedHandler(e -> updatePlans());
+        start.setCommand(e -> startMatch());
+        help.setCommand(e -> FOptionPane.showMessageDialog(
+                "Долгое нажатие — увеличить карту. Нажмите на зону, чтобы посмотреть её.\n"
+                + "Выбирайте атакующих и блокирующих на поле. Кнопки подсказки передают приоритет.\n"
+                + "Меню уступки позволяет вернуть ручной контроль. После партии доступен журнал и его копирование.\n"
+                + "Специализированный бот пока проходит проверку; превосходство над Forge не подтверждено.", "Управление"));
+        updatePlans();
+    }
+    public static void show() {
+        if (instance == null) { instance = new VintageSoloScreen(); }
+        Forge.openScreen(instance);
+    }
+    private void updatePlans() {
+        humanPlan.setText(humanDeck.getSelectedItem().plan);
+        botPlan.setText(botDeck.getSelectedItem().plan);
+    }
+    public static Deck loadDeck(Archetype type, boolean specialist) {
+        File file = new File(ForgeConstants.RES_DIR + "vintage-solo/" + type.file + ".dck");
+        if (!file.isFile()) { throw new IllegalStateException("Отсутствует файл колоды: " + file); }
+        Deck deck = DeckSerializer.fromFile(file);
+        if (deck == null || deck.getMain().countAll() != 60) {
+            throw new IllegalStateException("Колода должна содержать ровно 60 карт: " + type.title);
+        }
+        String problem = GameType.Constructed.getDeckFormat().getDeckConformanceProblem(deck);
+        if (problem != null || !FModel.getFormats().getVintage().isDeckLegal(deck)) {
+            throw new IllegalStateException("Недопустимая колода Vintage: " + type.title + "\n" + (problem == null ? "Проверьте ограничения формата" : problem));
+        }
+        VintageSolo.configure(deck, type, specialist);
+        return deck;
+    }
+    private void startMatch() {
+        if (starting || Forge.isLoadingaMatch()) { return; }
+        starting = true;
+        start.setEnabled(false);
+        Archetype human = humanDeck.getSelectedItem();
+        Archetype bot = botDeck.getSelectedItem();
+        FModel.getPreferences().setPref(FPref.UI_DISABLE_CARD_IMAGES, textCards.isSelected());
+        FModel.getPreferences().setPref(FPref.YIELD_AUTO_PASS_NO_ACTIONS, autoPass.isSelected());
+        FModel.getPreferences().setPref(FPref.YIELD_SKIP_PHASE_DELAY, true);
+        FModel.getPreferences().setPref(FPref.YIELD_SKIP_RESOLVE_DELAY, true);
+        FModel.getPreferences().setPref(FPref.UI_SHOW_AUTOTAP_PREVIEW, true);
+        FModel.getPreferences().save();
+        // Parse/validate decks away from the rendering thread, like LobbyScreen.
+        FThreads.invokeInBackgroundThread(() -> {
+            try {
+                Deck hd = loadDeck(human, false);
+                Deck bd = loadDeck(bot, true);
+                FThreads.invokeInEdtLater(() -> LoadingOverlay.show("Подготовка стола", true, () -> {
+                    try {
+                        RegisteredPlayer hp = new RegisteredPlayer(hd).setPlayer(GamePlayerUtil.getGuiPlayer());
+                        RegisteredPlayer bp = new RegisteredPlayer(bd).setPlayer(GamePlayerUtil.createAiPlayer("Vintage Bot", "Default"));
+                        GameRules rules = new GameRules(GameType.Constructed);
+                        rules.setGamesPerMatch(1);
+                        rules.setPlayForAnte(false);
+                        rules.setAllowCheatShuffle(false);
+                        rules.setAISideboardingEnabled(false);
+                        forge.StaticData.instance().setFilteredHandsEnabled(false);
+                        HostedMatch match = GuiBase.getInterface().hostMatch();
+                        match.startMatch(rules, null, List.of(hp, bp), hp, GuiBase.getInterface().getNewGuiGame());
+                    } catch (Exception ex) {
+                        FOptionPane.showErrorDialog(ex.getMessage(), "Не удалось начать партию");
+                    } finally { starting = false; start.setEnabled(true); }
+                }));
+            } catch (Exception ex) {
+                FThreads.invokeInEdtLater(() -> {
+                    starting = false;
+                    start.setEnabled(true);
+                    FOptionPane.showErrorDialog(ex.getMessage(), "Ошибка колоды");
+                });
+            }
+        });
+    }
+    @Override protected void drawBackground(Graphics g) {
+        g.fillRect(new Color(0.035f, 0.075f, 0.08f, 1), 0, 0, getWidth(), getHeight());
+        g.drawLine(Utils.scale(2), new Color(0.67f, 0.52f, 0.29f, 1), getWidth() * .08f,
+                getHeight() * .2f, getWidth() * .92f, getHeight() * .2f);
+    }
+    @Override protected void doLayout(float startY, float width, float height) {
+        float pad = Utils.scale(16), gap = Utils.scale(16);
+        float col = (width - 2 * pad - gap) / 2;
+        float row = Math.min(Utils.AVG_FINGER_HEIGHT, height * .12f);
+        title.setBounds(pad, startY + pad, width - 2 * pad, height * .15f);
+        float y = startY + height * .23f;
+        you.setBounds(pad, y, col, row * .65f);
+        opponent.setBounds(pad + col + gap, y, col, row * .65f);
+        y += row * .75f;
+        humanDeck.setBounds(pad, y, col, row);
+        botDeck.setBounds(pad + col + gap, y, col, row);
+        y += row + gap * .5f;
+        humanPlan.setBounds(pad, y, col, row);
+        botPlan.setBounds(pad + col + gap, y, col, row);
+        y += row + gap * .5f;
+        autoPass.setBounds(pad, y, col, row);
+        textCards.setBounds(pad + col + gap, y, col, row);
+        start.setBounds(width * .3f, height - pad - row * 1.2f, width * .4f, row * 1.2f);
+        help.setBounds(pad, height - pad - row, col * .48f, row);
+    }
+}
