diff --git a/tools/vintage-solo/tests/LocalChecks.java b/tools/vintage-solo/tests/LocalChecks.java
new file mode 100644
index 00000000..a494e84c
--- /dev/null
+++ b/tools/vintage-solo/tests/LocalChecks.java
@@ -0,0 +1,75 @@
+import forge.ai.vintage.OpeningHandPlanner;
+import forge.ai.vintage.OpeningHandPlanner.OpeningCard;
+import forge.util.VintageResources;
+import java.nio.file.*;
+import java.io.*;
+import java.util.*;
+import java.util.zip.*;
+
+public class LocalChecks {
+    static int checks;
+    static void check(boolean condition, String description) {
+        if (!condition) throw new AssertionError(description);
+        checks++;
+    }
+    static OpeningCard land(String name) { return new OpeningCard(name,0,true,false,false,false,false,false); }
+    static OpeningCard spell(String name,int cmc,boolean creature,boolean artifact,boolean white,boolean blue,boolean green) {
+        return new OpeningCard(name,cmc,false,creature,artifact,white,blue,green);
+    }
+    static byte[] zip(String name, String value) throws Exception {
+        ByteArrayOutputStream out=new ByteArrayOutputStream();
+        try(ZipOutputStream z=new ZipOutputStream(out)) {
+            z.putNextEntry(new ZipEntry(name)); z.write(value.getBytes(java.nio.charset.StandardCharsets.UTF_8)); z.closeEntry();
+        }
+        return out.toByteArray();
+    }
+    public static void main(String[] args) throws Exception {
+        OpeningCard plume=spell("White Plume Adventurer",3,true,false,true,false,false);
+        OpeningCard archon=spell("Archon of Emeria",3,true,false,true,false,false);
+        OpeningCard season=spell("Seasoned Dungeoneer",4,true,false,true,false,false);
+        OpeningCard chancellor=spell("Chancellor of the Annex",7,true,false,true,false,false);
+        var white=List.of(land("Ancient Tomb"),land("Plains"),plume,archon,season,chancellor,land("Wasteland"));
+        check(OpeningHandPlanner.choose("INITIATIVE",white,0).keep(),"White: castable pressure keep");
+        check(!OpeningHandPlanner.choose("INITIATIVE",List.of(plume,archon,season,chancellor,plume,archon,season),0).keep(),"White: no mana mulligan");
+        check(!OpeningHandPlanner.choose("INITIATIVE",List.of(land("Ancient Tomb"),land("Wasteland"),plume,archon,season,chancellor,plume),0).keep(),"White: colorless mana cannot cast white pressure");
+        check(OpeningHandPlanner.choose("INITIATIVE",white,1).bottom().equals(List.of(5)),"White: return expensive Chancellor over castable initiative");
+        OpeningCard ravager=spell("Arcbound Ravager",2,true,true,false,false,false);
+        OpeningCard inspector=spell("Foundry Inspector",3,true,true,false,false,false);
+        OpeningCard sphere=spell("Sphere of Resistance",2,false,true,false,false,false);
+        var shops=List.of(land("Mishra's Workshop"),land("Wasteland"),ravager,inspector,sphere,ravager,land("Ancient Tomb"));
+        check(OpeningHandPlanner.choose("WORKSHOP",shops,0).keep(),"Workshop: artifact curve keep");
+        check(!OpeningHandPlanner.choose("WORKSHOP",List.of(land("Tolarian Academy"),ravager,inspector,sphere,ravager,inspector,sphere),0).keep(),"Academy with no castable artifacts is not three mana");
+        OpeningCard oath=spell("Oath of Druids",2,false,false,false,false,true);
+        OpeningCard force=spell("Force of Will",5,false,false,false,true,false);
+        OpeningCard stock=spell("Stock Up",3,false,false,false,true,false);
+        OpeningCard atraxa=spell("Atraxa, Grand Unifier",7,true,false,true,true,true);
+        var control=List.of(land("Forbidden Orchard"),land("Tropical Island"),oath,force,stock,atraxa,land("Wasteland"));
+        check(OpeningHandPlanner.choose("OATH",control,0).keep(),"Oath: engine, Orchard, protection keep");
+        check(OpeningHandPlanner.choose("OATH",control,1).bottom().equals(List.of(5)),"Oath: put Atraxa back rather than engine or mana");
+        for(int n=0;n<=3;n++) {
+            var choice=OpeningHandPlanner.choose("OATH",control,n);
+            check(choice.bottom().size()==n && new HashSet<>(choice.bottom()).size()==n,"London exact unique bottom count "+n);
+        }
+        check(OpeningHandPlanner.choose("OATH",control,3).keep(),"Stop at four cards");
+        Path temp=Files.createTempDirectory("vintage-resource-test");
+        try {
+            VintageResources.install(new ByteArrayInputStream(zip("res/vintage-solo/oath.dck","deck")),temp.toFile(),"v1");
+            check(Files.readString(temp.resolve("vintage-res.version")).equals("v1"),"successful install marker");
+            VintageResources.install(new ByteArrayInputStream(zip("res/vintage-solo/oath.dck","changed")),temp.toFile(),"v1");
+            check(Files.readString(temp.resolve("res/vintage-solo/oath.dck")).equals("deck"),"same-version resume does not overwrite");
+            boolean rejected=false;
+            try { VintageResources.install(new ByteArrayInputStream(zip("res/../../escape","bad")),temp.toFile(),"v2"); }
+            catch(IOException expected) { rejected=true; }
+            check(rejected,"zip path traversal rejected");
+            check(Files.readString(temp.resolve("vintage-res.version")).equals("v1"),"failed update does not commit marker");
+            Path incomplete=temp.resolve("incomplete");
+            rejected=false;
+            try { VintageResources.install(new ByteArrayInputStream(zip("res/foo","x")),incomplete.toFile(),"v1"); }
+            catch(IOException expected) { rejected=true; }
+            check(rejected && !Files.exists(incomplete.resolve("vintage-res.version")),"incomplete installation is retryable");
+        } finally {
+            try(var files=Files.walk(temp)) { for(Path p:files.sorted(Comparator.reverseOrder()).toList()) Files.delete(p); }
+        }
+        System.out.println("PASS "+checks+" local assertions; no full Forge game executed");
+    }
+}
diff --git a/tools/vintage-solo/tests/ParseJava.java b/tools/vintage-solo/tests/ParseJava.java
new file mode 100644
index 00000000..9293a980
--- /dev/null
+++ b/tools/vintage-solo/tests/ParseJava.java
@@ -0,0 +1,15 @@
+import javax.tools.*;
+import com.sun.source.util.JavacTask;
+import java.util.*;
+public class ParseJava {
+    public static void main(String[] args) throws Exception {
+        JavaCompiler compiler=ToolProvider.getSystemJavaCompiler();
+        DiagnosticCollector<JavaFileObject> diagnostics=new DiagnosticCollector<>();
+        try(StandardJavaFileManager fm=compiler.getStandardFileManager(diagnostics,null,null)) {
+            JavacTask task=(JavacTask)compiler.getTask(null,fm,diagnostics,List.of("-proc:none"),null,fm.getJavaFileObjects(args));
+            task.parse();
+            for(var d:diagnostics.getDiagnostics()) if(d.getKind()==Diagnostic.Kind.ERROR) throw new AssertionError(d.toString());
+        }
+        System.out.println("PASS syntax parse: "+args.length+" Java files (not type checking)");
+    }
+}
