diff --git a/forge-gui-desktop/src/main/java/forge/view/VintageBenchmark.java b/forge-gui-desktop/src/main/java/forge/view/VintageBenchmark.java
new file mode 100644
index 00000000..a919d11d
--- /dev/null
+++ b/forge-gui-desktop/src/main/java/forge/view/VintageBenchmark.java
@@ -0,0 +1,89 @@
+package forge.view;
+
+import forge.StaticData;
+import forge.ai.LobbyPlayerAi;
+import forge.ai.PlayerControllerAi;
+import forge.deck.Deck;
+import forge.deck.VintageSolo;
+import forge.deck.VintageSolo.Archetype;
+import forge.deck.io.DeckSerializer;
+import forge.game.Game;
+import forge.game.GameRules;
+import forge.game.GameType;
+import forge.game.Match;
+import forge.game.player.Player;
+import forge.game.player.RegisteredPlayer;
+import forge.localinstance.properties.ForgeConstants;
+import forge.model.FModel;
+import forge.util.MyRandom;
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+/** One actual Forge game per process. The external runner owns timeout/error accounting. */
+public final class VintageBenchmark {
+    private VintageBenchmark() { }
+    public static void run(String[] args) {
+        if (args.length != 7) {
+            throw new IllegalArgumentException("vintage-bench INITIATIVE WORKSHOP specialist[-1/0/1] first[0/1] seed result.tsv");
+        }
+        Path output = Path.of(args[6]);
+        Game game = null;
+        try {
+            int specialist = Integer.parseInt(args[3]), first = Integer.parseInt(args[4]);
+            long seed = Long.parseLong(args[5]);
+            if (specialist < -1 || specialist > 1 || first < 0 || first > 1) { throw new IllegalArgumentException("Invalid player index"); }
+            FModel.initialize(null, null);
+            StaticData.instance().setFilteredHandsEnabled(false);
+            List<RegisteredPlayer> players = new ArrayList<>();
+            for (int index = 0; index < 2; index++) {
+                Archetype archetype = Archetype.valueOf(args[index + 1]);
+                Deck deck = DeckSerializer.fromFile(new File(ForgeConstants.RES_DIR + "vintage-solo/" + archetype.file + ".dck"));
+                if (deck == null || deck.getMain().countAll() != 60 || !FModel.getFormats().getVintage().isDeckLegal(deck)) {
+                    throw new IllegalStateException("Invalid deck " + archetype);
+                }
+                VintageSolo.configure(deck, archetype, index == specialist);
+                LobbyPlayerAi lobby = new LobbyPlayerAi("Bench" + index, null) {
+                    @Override public Player createIngamePlayer(Game g, int id) {
+                        Player player = new Player(getName(), g, id);
+                        player.setFirstController(new PlayerControllerAi(g, player, this) {
+                            @Override public Player chooseStartingPlayer(boolean isFirstGame) {
+                                return g.getPlayers().get(first);
+                            }
+                        });
+                        return player;
+                    }
+                };
+                lobby.setAiProfile("Default");
+                players.add(new RegisteredPlayer(deck).setPlayer(lobby));
+            }
+            GameRules rules = new GameRules(GameType.Constructed);
+            rules.setGamesPerMatch(1);
+            rules.setPlayForAnte(false);
+            rules.setAllowCheatShuffle(false);
+            rules.setAISideboardingEnabled(false);
+            Match match = new Match(rules, players, "Vintage benchmark");
+            MyRandom.setRandom(new Random(seed));
+            game = match.createGame();
+            game.setNoGUIUser();
+            match.startGame(game);
+            if (!game.isGameOver() || game.getOutcome() == null) { throw new IllegalStateException("Game returned without outcome"); }
+            int winner = game.getOutcome().isWinner(players.get(0)) ? 0 : game.getOutcome().isWinner(players.get(1)) ? 1 : -1;
+            Files.writeString(output, "COMPLETE\t" + winner + "\n");
+        } catch (Throwable ex) {
+            ex.printStackTrace();
+            try { Files.writeString(output, "ERROR\t" + ex.getClass().getName() + "\n"); }
+            catch (Exception writeFailure) { throw new RuntimeException(writeFailure); }
+        } finally {
+            if (game != null) {
+                StringBuilder log = new StringBuilder();
+                for (var entry : game.getGameLog().getAllEntries()) { log.append(entry).append('\n'); }
+                try { Files.writeString(Path.of(output + ".game.log"), log); }
+                catch (Exception ex) { ex.printStackTrace(); }
+            }
+        }
+    }
+}
