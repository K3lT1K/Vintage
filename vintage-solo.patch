@@ -0,0 +1,47 @@
+package forge.ai.vintage;
+
+import forge.deck.VintageSolo.Archetype;
+import forge.game.card.Card;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+
+/** Narrow target refinement; willingness, combat tricks and cost payment remain Forge's. */
+public final class VintageRemoval {
+    private VintageRemoval() { }
+    public static void refine(Player player, SpellAbility ability) {
+        if (!VintageStrategy.enabled(player) || !ability.getHostCard().getName().equals("Swords to Plowshares")
+                || !ability.isSpell() || !ability.usesTargeting()
+                || ability.getTargets().getTargetCards().size() != 1
+                || !player.getGame().getStack().isEmpty()
+                || player.getGame().getPhaseHandler().inCombat()) { return; }
+        Card previous = ability.getTargets().getTargetCards().get(0);
+        // Preserve Forge's self-removal/life-saving lines and every combat/stack response.
+        if (!previous.getController().isOpponentOf(player)) { return; }
+        Card best = previous;
+        int bestScore = score(player, previous);
+        for (Card candidate : player.getOpponents().getCreaturesInPlay()) {
+            if (candidate.isFaceDown() || !candidate.isInZone(ZoneType.Battlefield)
+                    || !ability.canTarget(candidate)) { continue; }
+            int score = score(player, candidate);
+            if (score > bestScore) { best = candidate; bestScore = score; }
+        }
+        if (best != previous) {
+            ability.resetTargets();
+            ability.getTargets().add(best);
+            VintageStrategy.log(player, "removal-threat", "target " + best.getName() + "; public engine/pressure score=" + bestScore);
+        }
+    }
+    private static int score(Player player, Card card) {
+        int score = Math.max(0, card.getNetPower()) * 3;
+        return score + switch (card.getName()) {
+            case "Atraxa, Grand Unifier" -> 90;
+            case "Arcbound Ravager" -> 65;
+            case "Steel Overseer" -> card.getController().getCreaturesInPlay().size() >= 3 ? 70 : 20;
+            case "Walking Ballista" -> 60;
+            case "Seasoned Dungeoneer", "White Plume Adventurer" -> 35;
+            case "Archon of Emeria" -> VintageStrategy.profile(player) == Archetype.OATH ? 75 : 10;
+            default -> 0;
+        };
+    }
+}
diff --git a/forge-ai/src/main/java/forge/ai/vintage/VintageStrategy.java b/forge-ai/src/main/java/forge/ai/vintage/VintageStrategy.java
new file mode 100644
index 00000000..91f1a774
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/vintage/VintageStrategy.java
@@ -0,0 +1,221 @@
+package forge.ai.vintage;
+
+import forge.deck.VintageSolo;
+import forge.deck.VintageSolo.Archetype;
+import forge.game.GameLogEntryType;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.card.CardCollectionView;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Soft strategic preferences. Forge still checks timing, targets, costs and mana restrictions.
+ * Reads own hand and public battlefield only. Search-option lists come from the engine.
+ * No RNG, library-order inspection, opponent-hand access, or direct state mutation. */
+public final class VintageStrategy {
+    public record Priority(int value, String rule, String reason) { }
+    private static final Priority FALLBACK = new Priority(0, "forge", "existing Forge evaluation");
+    private VintageStrategy() { }
+
+    public static boolean enabled(Player p) {
+        return p.getRegisteredPlayer().getDeck().getAiHints().contains(VintageSolo.SPECIALIST)
+                && VintageSolo.archetype(p.getRegisteredPlayer().getDeck()) != null;
+    }
+    public static Archetype profile(Player p) {
+        return VintageSolo.archetype(p.getRegisteredPlayer().getDeck());
+    }
+    private static boolean has(Iterable<Card> cards, String name) {
+        for (Card c : cards) { if (!c.isFaceDown() && c.getName().equals(name)) { return true; } }
+        return false;
+    }
+    private static int count(Iterable<Card> cards, String name) {
+        int count = 0;
+        for (Card c : cards) { if (!c.isFaceDown() && c.getName().equals(name)) { count++; } }
+        return count;
+    }
+    public static void log(Player p, String rule, String reason) {
+        if (enabled(p)) {
+            p.getGame().getGameLog().add(GameLogEntryType.INFORMATION,
+                    "[Vintage AI] " + profile(p) + " / " + rule + ": " + reason);
+        }
+    }
+    private static OpeningHandPlanner.Choice opening(Player p, CardCollectionView hand, int bottom) {
+        List<OpeningHandPlanner.OpeningCard> cards = new ArrayList<>();
+        for (Card c : hand) {
+            cards.add(new OpeningHandPlanner.OpeningCard(c.getName(), c.getCMC(), c.isLand(), c.isCreature(),
+                    c.isArtifact(), c.getColor().hasWhite(), c.getColor().hasBlue(), c.getColor().hasGreen()));
+        }
+        return OpeningHandPlanner.choose(profile(p).name(), cards, bottom);
+    }
+    public static Boolean keepHand(Player p, int bottom) {
+        CardCollectionView hand = p.getCardsIn(ZoneType.Hand);
+        if (!enabled(p) || hand.size() > 10) { return null; }
+        OpeningHandPlanner.Choice choice = opening(p, hand, bottom);
+        log(p, "mulligan", (choice.keep() ? "keep; " : "mulligan; ") + choice.reason());
+        return choice.keep();
+    }
+    public static CardCollection bottom(Player p, CardCollectionView hand, int n) {
+        if (!enabled(p) || hand.size() > 10) { return null; }
+        OpeningHandPlanner.Choice choice = opening(p, hand, n);
+        CardCollection result = new CardCollection();
+        for (int index : choice.bottom()) { result.add(hand.get(index)); }
+        log(p, "bottom", "return " + result.size() + " cards; " + choice.reason());
+        return result;
+    }
+
+    /** Apply after Forge's normal ordering. A stable sort preserves all fallback ties. */
+    public static void order(Player p, List<SpellAbility> abilities) {
+        if (!enabled(p)) { return; }
+        Map<SpellAbility, Integer> scores = new HashMap<>();
+        for (SpellAbility sa : abilities) { scores.put(sa, priority(p, sa).value()); }
+        abilities.sort(Comparator.comparingInt((SpellAbility sa) -> scores.get(sa)).reversed());
+    }
+    public static Priority priority(Player p, SpellAbility sa) {
+        if (!enabled(p) || sa.getHostCard().isFaceDown()) { return FALLBACK; }
+        Card c = sa.getHostCard();
+        // Never score a concealed library card just because Forge enumerated its abilities.
+        if (!(c.isInZone(ZoneType.Hand) && c.getController().equals(p))
+                && !c.isInZone(ZoneType.Battlefield) && !c.isInZone(ZoneType.Stack)) { return FALLBACK; }
+        String n = c.getName();
+        CardCollectionView hand = p.getCardsIn(ZoneType.Hand);
+        CardCollectionView board = p.getCardsIn(ZoneType.Battlefield);
+        boolean emptyStack = p.getGame().getStack().isEmpty();
+        if (!emptyStack) { return FALLBACK; } // Counter timing/response belongs to Forge's stack evaluator.
+        if (sa.isSpell() && (n.startsWith("Mox ") || n.equals("Black Lotus") || n.equals("Mana Crypt")
+                || n.equals("Sol Ring") || n.equals("Chrome Mox"))) {
+            boolean disabled = has(p.getGame().getCardsIn(ZoneType.Battlefield), "Null Rod")
+                    || has(p.getGame().getCardsIn(ZoneType.Battlefield), "Clarion Conqueror");
+            if (!disabled) { return new Priority(90, "mana-before-lock", "develop mana before symmetric taxes"); }
+        }
+        return switch (profile(p)) {
+            case INITIATIVE -> initiative(p, sa, n, board);
+            case WORKSHOP -> workshop(p, sa, n, hand, board);
+            case OATH -> oath(p, sa, n, hand, board);
+        };
+    }
+    private static Priority initiative(Player p, SpellAbility sa, String n, CardCollectionView board) {
+        if (!sa.isSpell()) { return FALLBACK; }
+        if (n.equals("Clarion Conqueror") && opponentProfile(p) == Archetype.WORKSHOP) {
+            return new Priority(85, "workshop-disruption", "shut down opposing artifact activations");
+        }
+        if (n.equals("White Plume Adventurer") || n.equals("Seasoned Dungeoneer")) {
+            return new Priority(80, "initiative-pressure", "develop initiative and combat pressure");
+        }
+        if (n.equals("Archon of Emeria") && opponentProfile(p) == Archetype.OATH && !has(board, n)) {
+            return new Priority(75, "oath-disruption", "limit the control deck's spell sequencing");
+        }
+        return FALLBACK;
+    }
+    private static Priority workshop(Player p, SpellAbility sa, String n, CardCollectionView hand, CardCollectionView board) {
+        if (!sa.isSpell()) { return FALLBACK; }
+        if (n.equals("Foundry Inspector") && hand.size() > 2) {
+            return new Priority(85, "discount-before-tax", "establish artifact discount before further spells");
+        }
+        if ((n.equals("Sphere of Resistance") || n.equals("Thorn of Amethyst") || n.equals("Trinisphere"))
+                && opponentProfile(p) == Archetype.OATH && !has(board, n)) {
+            return new Priority(75, "tax-control", "tax control/combo after mana development");
+        }
+        if ((n.equals("Steel Overseer") || n.equals("Arcbound Ravager")) && p.getCreaturesInPlay().size() >= 2) {
+            return new Priority(65, "scale-board", "grow an established artifact board");
+        }
+        if (sa.getHostCard().isCreature() && opponentProfile(p) == Archetype.WORKSHOP) {
+            return new Priority(55, "mirror-board", "in the mirror prioritize bodies over symmetric taxes");
+        }
+        return FALLBACK;
+    }
+    private static Priority oath(Player p, SpellAbility sa, String n, CardCollectionView hand, CardCollectionView board) {
+        if (sa.isSpell() && n.equals("Oath of Druids") && !has(board, n)) {
+            int theirCreatures = p.getOpponents().getCreaturesInPlay().size();
+            if (theirCreatures > p.getCreaturesInPlay().size() || has(board, "Forbidden Orchard")) {
+                return new Priority(85, "oath-engine", "establish Oath with a public creature imbalance or Orchard");
+            }
+        }
+        if (sa.isSpell() && n.equals("Null Rod") && opponentProfile(p) == Archetype.WORKSHOP && !has(board, n)) {
+            return new Priority(80, "disable-workshop", "disable artifact activations in the Workshop matchup");
+        }
+        if (sa.isSpell() && (n.equals("Stock Up") || n.equals("Brainstorm") || n.equals("Ancestral Recall"))
+                && !has(hand, "Oath of Druids") && !has(board, "Oath of Druids")) {
+            return new Priority(60, "find-engine", "find the missing engine using ordinary draw effects");
+        }
+        return FALLBACK;
+    }
+    /** Called after CounterAi has validated stack target and unless-cost logic.
+     * Do not randomly pass low-CMC engines that invalidate the selected deck's plan. */
+    public static boolean urgentCounter(Player p, SpellAbility target) {
+        if (!enabled(p) || target == null || target.getHostCard().isFaceDown()
+                || !target.getActivatingPlayer().isOpponentOf(p)) { return false; }
+        String name = target.getHostCard().getName();
+        boolean urgent = name.equals("Ancestral Recall") || name.equals("Time Walk")
+                || (name.equals("Oath of Druids") && !has(p.getCardsIn(ZoneType.Battlefield), name))
+                || (profile(p) == Archetype.WORKSHOP && (name.equals("Null Rod") || name.equals("Clarion Conqueror")))
+                || (profile(p) == Archetype.OATH && name.equals("Archon of Emeria"));
+        if (urgent) { log(p, "counter-engine", "prioritize public stack threat: " + name); }
+        return urgent;
+    }
+
+    public static Archetype opponentProfile(Player p) {
+        Player other = p.getWeakestOpponent();
+        return other == null ? null : VintageSolo.archetype(other.getRegisteredPlayer().getDeck());
+    }
+
+    public static Card chooseLand(Player p, CardCollection options) {
+        if (!enabled(p) || options.isEmpty()) { return null; }
+        // MDFCs and unusual board states remain with Forge's original land evaluator.
+        Card best = null;
+        int score = 0;
+        for (Card c : options) {
+            if (!c.isLand() || c.isFaceDown()) { continue; }
+            int next = landScore(p, c);
+            if (next > score) { score = next; best = c; }
+        }
+        if (best != null) { log(p, "land", best.getName() + "; profile mana/engine priority"); }
+        return best;
+    }
+    private static int landScore(Player p, Card c) {
+        String n = c.getName();
+        CardCollectionView hand = p.getCardsIn(ZoneType.Hand);
+        CardCollectionView board = p.getCardsIn(ZoneType.Battlefield);
+        if (profile(p) == Archetype.WORKSHOP && n.equals("Mishra's Workshop")
+                && hand.stream().anyMatch(x -> x.isArtifact() && !x.isLand())) { return 100; }
+        if (profile(p) == Archetype.OATH) {
+            if (n.equals("Forbidden Orchard") && (has(hand, "Oath of Druids") || has(board, "Oath of Druids"))
+                    && p.getOpponents().getCreaturesInPlay().size() <= p.getCreaturesInPlay().size()
+                    && opponentProfile(p) != Archetype.OATH) { return 95; }
+            if (n.equals("Tropical Island") && !has(board, n)) { return 70; }
+        }
+        if (profile(p) == Archetype.INITIATIVE) {
+            boolean white = has(board, "Plains") || has(board, "Karakas") || has(board, "Mox Pearl")
+                    || has(board, "Cavern of Souls") || has(board, "Witch-Blessed Meadow");
+            if (!white && (n.equals("Plains") || n.equals("Karakas") || n.equals("Cavern of Souls"))) { return 80; }
+            if (white && n.equals("Ancient Tomb") && p.getLife() > 6) { return 75; }
+        }
+        return 0;
+    }
+    /** Legal, unordered tutor options. This callback is reached only when an actual search permits it. */
+    public static Card search(Player p, CardCollection options, SpellAbility sa, Player owner, Player decider) {
+        if (!enabled(p) || !p.equals(owner) || !p.equals(decider) || options.isEmpty()) { return null; }
+        String source = sa.getHostCard().getName();
+        if (!List.of("Misty Rainforest", "Scalding Tarn", "Polluted Delta", "Lórien Revealed", "Urza's Saga").contains(source)) {
+            return null;
+        }
+        Card best = null;
+        int bestScore = 0;
+        for (Card c : options) {
+            int score = landScore(p, c);
+            if (source.equals("Urza's Saga")) {
+                score = c.getName().equals("Sol Ring") ? 65 : c.getName().equals("Mox Pearl") ? 50 : 0;
+            }
+            if (score > bestScore || (score > 0 && score == bestScore && best != null
+                    && c.getName().compareTo(best.getName()) < 0)) { best = c; bestScore = score; }
+        }
+        if (best != null) { log(p, "search", "choose engine/mana role from legal search options"); }
+        return best;
+    }
+}
