+#!/usr/bin/env python3
+"""Produce deterministic offline APK assets from this checkout (no network)."""
+import hashlib
+import pathlib
+import zipfile
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+resources = ROOT / 'forge-gui/res'
+output = ROOT / 'forge-gui-android/assets'
+output.mkdir(parents=True, exist_ok=True)
+digest = hashlib.sha256()
+with zipfile.ZipFile(output / 'vintage-res.zip', 'w', compression=zipfile.ZIP_DEFLATED, compresslevel=3) as archive:
+    for path in sorted(resources.rglob('*')):
+        if not path.is_file() or path.suffix == '.xcf':
+            continue
+        name = 'res/' + path.relative_to(resources).as_posix()
+        data = path.read_bytes()
+        digest.update(name.encode('utf-8') + b'\0' + data)
+        info = zipfile.ZipInfo(name, (2026, 9, 8, 0, 0, 0))
+        info.compress_type = zipfile.ZIP_DEFLATED
+        archive.writestr(info, data, compresslevel=3)
+(output / 'vintage-res.version').write_text(digest.hexdigest(), encoding='ascii')
+print('Offline resources:', output / 'vintage-res.zip', digest.hexdigest())
